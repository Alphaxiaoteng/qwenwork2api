# QwenWork2API 配置文件示例
# 复制为 .env 并填入你的 API Key 即可：
# cp .env.example .env

# 服务的监听端口（默认 8796）
PORT=8796

# 阿里云百炼 / 通义千问 API Key (支持 QWENWORK_API_KEY 或 DASHSCOPE_API_KEY)
# 获取地址: https://bailian.console.aliyun.com/
QWENWORK_API_KEY=sk-your-dashscope-api-key-here

# 可选：自定义上游地址（默认直接走百炼兼容模式）
QWENWORK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
